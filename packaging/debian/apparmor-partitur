# AppArmor profile of the Debian and Ubuntu package's /usr/bin/partitur.
#
# It confines nothing (flags=(unconfined)) and only grants `userns`: CEF, which renders MCP App
# widgets, sandboxes its processes in unprivileged user namespaces, and Ubuntu 23.10 and later
# let a program create one only when its profile says so. Without this profile the sandbox
# probe fails there and the widgets run without CEF's process sandbox. It is the profile Ubuntu
# itself ships for other Chromium-based programs.

abi <abi/4.0>,
include <tunables/global>

profile partitur /usr/bin/partitur flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/partitur>
}
